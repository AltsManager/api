# Copy to .env and adjust as needed for local development.

DATABASE_URL=postgresql+psycopg://altsmanager:altsmanager@localhost:5432/altsmanager
# Generate a real value for anything beyond local dev, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with this placeholder when ENVIRONMENT=production.
SECRET_KEY=change-me-to-a-random-value-at-least-32-bytes-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./data/documents
# Only used when STORAGE_BACKEND=s3 (works with AWS S3, MinIO, Backblaze B2, ...)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ENVIRONMENT=development
# Comma-separated list of origins allowed to make credentialed requests (the web frontend)
CORS_ORIGINS=http://localhost:3000
# Document upload limits
MAX_UPLOAD_SIZE_BYTES=26214400
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
